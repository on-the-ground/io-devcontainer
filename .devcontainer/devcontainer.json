{
  "name": "Io Dev",
  "image": "joohyungpark/io-devcontainer:latest",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Io Browser REPL",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "WebAssembly.vscode-wasm-language-tools"
      ]
    }
  }
}
